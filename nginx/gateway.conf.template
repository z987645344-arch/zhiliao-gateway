        root /usr/share/nginx/html;
    }

    location = /gateway-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # TODO(zhitian): keep the stricter route set empty until the zhitian commander confirms paths.
    # SSE routes that must not be guessed into a stricter class:
    # POST /chat/stream             (conversation stream, usually 30-90 seconds)
    # GET  /tasks/{task_id}/stream  (document-ingestion progress, duration varies by document)
    location / {
        limit_req zone=general burst=200 nodelay;
        limit_conn perip 200;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_intercept_errors on;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP         $remote_addr;
